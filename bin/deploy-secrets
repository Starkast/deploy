#!/bin/sh
# Keep a repo's secrets in the repo, encrypted with age. Each secret is one file,
# secrets/<NAME>.age, so changes show up per secret and setting one only takes
# the public keys in secrets/recipients. A deploy decrypts them with the host's key.
#
#   deploy-secrets add-github <user>           people, their keys on GitHub
#   deploy-secrets add <recipient> [comment]   hosts, or a key from elsewhere
#   deploy-secrets set <NAME>                  from a prompt, or piped in
#   deploy-secrets import <NAME>...            from NAME=value lines on stdin
#   deploy-secrets get <NAME>
#   deploy-secrets list
#   deploy-secrets rm <NAME>
#   deploy-secrets rekey                       after changing secrets/recipients
#
# Needs age. get and rekey read your private key, DEPLOY_SECRETS_IDENTITY or
# ~/.ssh/id_ed25519 by default. age can't use an SSH agent.
set -eu
umask 077

dir=${DEPLOY_SECRETS_DIR:-secrets}
recipients=$dir/recipients
github=${DEPLOY_SECRETS_GITHUB:-https://github.com}

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  sed -n '/^#   /s/^#   /usage: /p' "$0" >&2
  exit 1
}

check_name() {
  case $1 in
  '' | [0-9]* | *[!A-Za-z0-9_]*) die "Not an environment variable name: $1" ;;
  esac
}

encrypt() { # name, the value on stdin
  [ -s "$recipients" ] || die "No recipients yet, see deploy-secrets add-github"
  age --armor --recipients-file "$recipients" --output "$dir/.$1.tmp" || {
    rm -f "$dir/.$1.tmp"
    die "Couldn't encrypt $1"
  }
  mv "$dir/.$1.tmp" "$dir/$1.age"
}

identity() {
  identity=${DEPLOY_SECRETS_IDENTITY:-$HOME/.ssh/id_ed25519}
  [ -r "$identity" ] || die "Can't read $identity, set DEPLOY_SECRETS_IDENTITY"
}

decrypt() { # name
  [ -f "$dir/$1.age" ] || die "No secret named $1"
  age --decrypt --identity "$identity" "$dir/$1.age"
}

add_recipient() { # key, comment
  mkdir -p "$dir"
  [ -f "$recipients" ] && grep -qxF "$1" "$recipients" && return 0
  printf '# %s\n%s\n' "$2" "$1" >> "$recipients"
  added=1
}

added=
after_adding() {
  [ -z "$added" ] || ! ls "$dir"/*.age > /dev/null 2>&1 ||
    echo "Run deploy-secrets rekey for the new recipients to read the existing secrets" >&2
}

[ $# -gt 0 ] || usage
command=$1
shift

case $command in
add-github)
  [ $# -eq 1 ] || usage
  keys=$(curl -fsS --max-time 30 "$github/$1.keys") || die "Couldn't get $1's keys from GitHub"
  usable=$(printf '%s\n' "$keys" | grep -E '^(ssh-ed25519|ssh-rsa) ' || true)
  [ -n "$usable" ] || die "$1 has no ssh-ed25519 or ssh-rsa keys on GitHub, age can't use the others"
  while IFS= read -r key; do
    add_recipient "$key" "github.com/$1"
  done << KEYS
$usable
KEYS
  after_adding
  ;;
add)
  [ $# -ge 1 ] && [ $# -le 2 ] || usage
  case $1 in
  age1* | "ssh-ed25519 "* | "ssh-rsa "*) ;;
  *) die "age can't encrypt to: $1" ;;
  esac
  add_recipient "$1" "${2:-added by hand}"
  after_adding
  ;;
set)
  [ $# -eq 1 ] || usage
  check_name "$1"
  if [ -t 0 ]; then
    printf '%s: ' "$1" >&2
    stty -echo
    IFS= read -r value || true
    stty echo
    echo >&2
  else
    value=$(cat)
  fi
  [ -n "$value" ] || die "No value for $1"
  printf '%s\n' "$value" | encrypt "$1"
  ;;
import)
  [ $# -ge 1 ] || usage
  input=$(cat)
  for name in "$@"; do
    check_name "$name"
    line=$(printf '%s\n' "$input" | grep -m 1 "^$name=" || true)
    [ -n "$line" ] || die "No $name on stdin"
    printf '%s\n' "${line#*=}" | encrypt "$name"
  done
  ;;
get)
  [ $# -eq 1 ] || usage
  check_name "$1"
  identity
  decrypt "$1"
  ;;
list)
  [ $# -eq 0 ] || usage
  for file in "$dir"/*.age; do
    [ -e "$file" ] || continue
    name=${file##*/}
    echo "${name%.age}"
  done
  ;;
rm)
  [ $# -eq 1 ] || usage
  check_name "$1"
  [ -f "$dir/$1.age" ] || die "No secret named $1"
  rm "$dir/$1.age"
  ;;
rekey)
  [ $# -eq 0 ] || usage
  identity
  for file in "$dir"/*.age; do
    [ -e "$file" ] || continue
    name=${file##*/}
    name=${name%.age}
    value=$(decrypt "$name") || die "Couldn't decrypt $name, run rekey again with a key that can"
    printf '%s\n' "$value" | encrypt "$name"
  done
  ;;
*)
  usage
  ;;
esac
